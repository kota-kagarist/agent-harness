# Provider: "openai" (default) talks to any OpenAI-compatible chat
# completions endpoint — Meta Model API, OpenAI, or a local server.
# "anthropic" uses the Claude Messages API natively; then LLM_BASE_URL
# defaults to https://api.anthropic.com and LLM_MODEL is a Claude model
# id (e.g. claude-sonnet-4-5). Note: Anthropic requests do not stream —
# replies arrive in one chunk.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=

# Directory holding IDENTITY.md / USER.md / MEMORY.md / schedules.json
AGENT_WORKSPACE=./workspace

# Set to 1 to let approval-gated tools run without a human in the loop
# (scheduler / --once mode). Leave unset for safe-by-default behavior.
AGENT_ALLOW_UNATTENDED=

# Rough token budget for conversation history (estimated as chars / 4).
# Older turns are compacted into a summary past this size. Default 24000.
AGENT_COMPACT_THRESHOLD=
